# One DeepSeek key is shared by support chat and AI email drafting.
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible endpoint override.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional shared rate limiting on Vercel. If omitted, a per-instance fallback is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend is used by the public contact form. In production, the sender must
# belong to a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@your-verified-domain.com
CONTACT_RECIPIENT_EMAIL=jie.craft@outlook.com
